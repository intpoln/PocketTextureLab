{ "cols": 4, "size": 256, "resolution": 512, "background": "#000", "cases": [
  { "label": "1. Звёздная вспышка", "t": 0.3, "script": "const f=PTL.addNode('flare',{params:{...flarePreset({glowI:1.1,glowSize:0.55,glowFall:3,glowColor:[1,0.84,0.6,1],coreI:2.2,coreSize:0.035,raysI:1.3,raysCount:4,raysLen:0.78,raysSharp:55,raysRandom:0,raysColor:[1,0.94,0.82,1],shimI:0.45,shimCount:110,shimLen:0.55,shimSharp:5,shimSpeed:1,ringI:0.06,ringRadius:0.3,ringWidth:0.02,ringChroma:0.8}),background:'transparent'}});const g=PTL.addNode('glow',{params:{threshold:0.3,radius:8,intensity:1.3}});PTL.connect(f,0,g,0);return g" },
  { "label": "2. Дым", "t": 0.3, "script": "const m=PTL.addNode('noise',{params:{type:'splat',scale:3,octaves:4,seed:12,splSize:0.75,splHard:0,splIn:'smax',splAcross:'add',persistence:0.45,splSizeRand:0.6}});const fl=PTL.addNode('noise',{params:{type:'flow',scale:5,octaves:4,seed:3,advect:0.6,flowSpin:1,persistence:0.5}});const w=PTL.addNode('warp',{params:{mode:'gradient',intensity:0.08,mapBlur:8}});PTL.connect(m,0,w,0);PTL.connect(fl,0,w,1);const d=PTL.addNode('blend',{params:{mode:'multiply',opacity:0.45}});PTL.connect(w,0,d,0);PTL.connect(fl,0,d,1);const sh=PTL.addNode('shape',{params:{shape:'ellipse',sizeX:0.9,sizeY:0.9,softness:0.5,repeat:false}});const mul=PTL.addNode('blend',{params:{mode:'multiply'}});PTL.connect(d,0,mul,0);PTL.connect(sh,0,mul,1);const lv=PTL.addNode('levels',{params:{inBlack:0.04,inWhite:0.7}});PTL.connect(mul,0,lv,0);const r=PTL.addNode('ramp',{params:{stops:[{p:0,c:[0.1,0.1,0.11,0]},{p:0.35,c:[0.4,0.4,0.42,0.6]},{p:0.75,c:[0.75,0.75,0.77,0.92]},{p:1,c:[0.96,0.96,0.96,1]}]}});PTL.connect(lv,0,r,0);return r" },
  { "label": "3. Энергетические волокна", "t": 0.3, "script": "const s=PTL.addNode('noise',{params:{type:'splat',scale:6,octaves:2,seed:7,splShape:'streak',splAspect:14,splSize:0.45,splRotRand:0.03,splAngle:15,splPer:3,splDensity:0.9,splIn:'max',splAcross:'max',persistence:0.8,splHard:0}});const db=PTL.addNode('dirblur',{params:{length:30,angle:15,wrap:'repeat'}});PTL.connect(s,0,db,0);const fl=PTL.addNode('noise',{params:{type:'flow',scale:2,octaves:3,seed:5}});const w=PTL.addNode('warp',{params:{mode:'directional',angle:105,intensity:0.04}});PTL.connect(db,0,w,0);PTL.connect(fl,0,w,1);const lv=PTL.addNode('levels',{params:{inBlack:0.2,inWhite:0.8,gamma:0.8}});PTL.connect(w,0,lv,0);const r=PTL.addNode('ramp',{params:{stops:[{p:0,c:[0,0,0.04,1]},{p:0.4,c:[0.12,0.04,0.45,1]},{p:0.75,c:[0.2,0.6,1,1]},{p:1,c:[0.92,1,1,1]}]}});PTL.connect(lv,0,r,0);const g=PTL.addNode('glow',{params:{threshold:0.5,radius:5,intensity:1.1,wrap:'repeat'}});PTL.connect(r,0,g,0);return g" },
  { "label": "4. Камни (цвет)", "script": "const v=PTL.addNode('voronoi',{params:{mode:'border',scale:5,seed:21,edgeSmooth:0.62,randomness:0.9}});const n=PTL.addNode('noise',{params:{type:'perlin',scale:12,octaves:6,seed:2,persistence:0.55}});const b=PTL.addNode('blend',{params:{mode:'multiply',opacity:0.25}});PTL.connect(v,0,b,0);PTL.connect(n,0,b,1);const r=PTL.addNode('ramp',{params:{stops:[{p:0,c:[0.18,0.16,0.14,1]},{p:0.3,c:[0.35,0.32,0.28,1]},{p:1,c:[0.72,0.68,0.6,1]}]}});PTL.connect(b,0,r,0);return r" }
] }
